#
# Installing never starts or enables the service and adds no user to the group. The rule for polkit comes with the
# package: members of the group may start the service without a password, nothing else.

post_install() {
  echo "Celata needs the hide.me command-line client (AUR: hide-client) and a hide.me account."
  echo "To use it, add your user to the group, then log out and back in once:"
  echo "  sudo usermod -aG celata \"\$USER\""
  echo "Celata starts the service by itself when it needs it."
  echo "See /usr/share/doc/celata/README.md."
}

# Removing stops the service (which lifts an internet block) and disables it. An update does not run this.
pre_remove() {
  systemctl disable --now celata-hide.me.service >/dev/null 2>&1 || true
}
