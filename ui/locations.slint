// View "Locations": search, tabs "Standard" and "Streaming", list and bar for connecting.

import { LineEdit, ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { BestIcon, Card, ExpandArrow, Flag, PrimaryButton, SecondaryButton, Star, Tabs, Toggle } from "widgets.slint";

// A row of the location list. The contents come from `src/look.rs` (`LocationItem`), the flag from the
// image cache in `src/main.rs`; without a flag `flag` stays empty.
export struct LocationItem {
    // "heading", "location", "country", "child", "missing", "loading" or "best" ("Best location": Celata logo
    // instead of the flag, host and star-host "best", place the hint or "Chosen: …")
    kind: string,
    flag: image,
    // Country name (bold), the text of a heading, or empty
    country: string,
    // Place, "Automatic, hide.me chooses the location", "Streaming", place of an unfolded location, or the host
    // name of a favourite that is missing or loading
    place: string,
    // Host for connecting; empty: the row cannot be selected
    host: string,
    // Host the star switches; empty: no star
    star-host: string,
    free: bool,
    // Text for the selected location, for example "Australia, Melbourne"
    choice: string,
    favorite: bool,
    expandable: bool,
    expanded: bool,
    // Folded, and a location below it is selected or connected
    holds-selected: bool,
    holds-connected: bool,
    // Country code, for the arrow (`toggle-country`)
    code: string,
}

// A list of locations: a click selects, a double click connects or switches. Star and arrow catch their
// clicks themselves; the row never gets them. Used for both tabs, so that the handling does not differ.
component ServerList inherits VerticalLayout {
    in property <[LocationItem]> rows;
    in property <bool> can-connect;
    // While connected: switching to a server other than the connected one is possible
    in property <bool> can-switch;
    in property <string> connected-host;
    // Show "No results" if the list is empty
    in property <bool> show-empty;
    in-out property <string> selected-host;
    in-out property <string> selected-name;
    // Scroll position of the list. Rust moves it when rows above the visible area are inserted or removed, so
    // that the visible rows stay where they are (star, arrow).
    in-out property <length> scroll-y;
    callback connect(string);
    callback selection-changed(string);
    callback toggle-favorite(string);
    callback toggle-country(string);
    spacing: 8px;

    if root.show-empty && root.rows.length == 0: Text {
        text: @tr("No results");
        color: Theme.text-soft;
    }

    ListView {
        vertical-stretch: 1;
        min-height: 104px;
        content-y <=> root.scroll-y;

        // All rows have the same height, headings and unfolded locations as well: the list estimates its
        // total height from the visible rows. With differing heights the scroll bar would not follow the
        // mouse pointer.
        for row in root.rows: line := Rectangle {
            // Headings and favourites that cannot be selected have no hover and no selection colour.
            property <bool> plain: row.kind == "heading" || row.kind == "missing" || row.kind == "loading";
            property <bool> unavailable: row.kind == "missing" || row.kind == "loading";
            property <bool> connected: (row.host != "" && row.host == root.connected-host) || row.holds-connected;
            height: 52px;
            background: line.plain
                ? Theme.card
                : (row.host != "" && row.host == root.selected-host) || row.holds-selected
                    ? Theme.row-selected
                    : touch.has-hover ? Theme.row-hover : Theme.card;

            // The touch area contains the row, so that star and arrow inside it get their clicks first.
            touch := TouchArea {
                enabled: !line.plain;
                clicked => {
                    if (row.host != "") {
                        root.selected-host = row.host;
                        root.selected-name = row.choice;
                        root.selection-changed(row.host);
                    } else if (row.kind == "country") {
                        // Country without "Automatic": the row folds and unfolds.
                        root.toggle-country(row.code);
                    }
                }
                double-clicked => {
                    if (row.host != "") {
                        root.selected-host = row.host;
                        root.selected-name = row.choice;
                        root.selection-changed(row.host);
                        if (root.can-connect || (root.can-switch && row.host != root.connected-host)) {
                            root.connect(row.host);
                        }
                    }
                }

                // Heading: larger than the country names, with a fine line below it
                if row.kind == "heading": Text {
                    x: 12px;
                    y: parent.height - self.height - 8px;
                    width: parent.width - 24px;
                    text: row.country;
                    font-size: 17px;
                    font-weight: 600;
                    color: Theme.text;
                    overflow: elide; // may be cut: heading of a list
                }

                if row.kind == "heading": Rectangle {
                    x: 12px;
                    y: parent.height - 2px;
                    width: parent.width - 24px;
                    height: 1px;
                    background: Theme.card-border;
                }

                if row.kind != "heading": HorizontalLayout {
                    // Unfolded locations are indented below the flag of their country.
                    padding-left: row.kind == "child" ? 48px : 12px;
                    padding-right: 8px;
                    spacing: 12px;

                    VerticalLayout {
                        alignment: center;
                        // Flag or, for "Best location", the logo in the same place, switched through `visible`.
                        Rectangle {
                            width: 24px;
                            height: 24px;
                            Flag {
                                y: 3px;
                                source: row.flag;
                                visible: row.kind != "best";
                            }
                            BestIcon {
                                visible: row.kind == "best";
                            }
                        }
                    }

                    // The texts take only their own width, so that the arrow follows right behind the longer
                    // of the two lines; the free space lies between arrow and star.
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;

                        // Country name, for unfolded locations the place, for unavailable favourites the host
                        Text {
                            text: row.kind == "child" || line.unavailable ? row.place : row.country;
                            font-size: Theme.country;
                            font-weight: row.kind == "child" || line.unavailable ? 400 : 600;
                            color: Theme.text;
                            overflow: elide; // may be cut: row of a list, the full name is shown in the overview
                        }

                        if row.kind != "child" && (row.place != "" || line.unavailable): Text {
                            text: row.kind == "missing"
                                ? @tr("not available")
                                : row.kind == "loading" ? @tr("Loading …") : row.place;
                            font-size: Theme.place;
                            color: Theme.text-soft;
                            overflow: elide; // may be cut: row of a list, the full name is shown in the overview
                        }
                    }

                    // Arrow close to the country, the star stays at the right edge.
                    if row.expandable: VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        ExpandArrow {
                            open: row.expanded;
                            toggled => {
                                root.toggle-country(row.code);
                            }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    if row.free: Text {
                        text: @tr("free");
                        font-size: 12px;
                        color: Theme.free-text;
                        horizontal-stretch: 0;
                        vertical-alignment: center;
                    }

                    if line.connected: VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;

                        Rectangle {
                            height: 20px;
                            min-width: badge.preferred-width + 16px;
                            border-radius: 10px;
                            background: Theme.accent;

                            badge := Text {
                                text: @tr("Connected");
                                font-size: 11px;
                                font-weight: 600;
                                color: Theme.on-dark;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if row.star-host != "": VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        Star {
                            on: row.favorite;
                            toggled => {
                                root.toggle-favorite(row.star-host);
                            }
                        }
                    }
                }
            }
        }
    }
}

export component LocationsView inherits VerticalLayout {
    in property <[LocationItem]> servers;
    in property <[LocationItem]> streaming-servers;
    // "loading", "ready" or "error"
    in property <string> list-state;
    in property <string> list-message;
    in property <bool> can-connect;
    in property <bool> connecting;
    in property <bool> can-disconnect;
    in property <bool> can-switch;
    in property <string> connected-host;
    in property <bool> switching;
    in-out property <string> search-text;
    in-out property <string> selected-host;
    in-out property <string> selected-name;
    // Selected tab, remembered in the window so that it is kept when the view changes
    in-out property <int> tab;
    // "Free only" in the tab "Standard"; Rust filters the list
    in-out property <bool> free-only;
    // Scroll positions of both lists, kept in the window
    in-out property <length> servers-scroll;
    in-out property <length> streaming-scroll;

    callback search-changed(string);
    callback reload-servers();
    callback connect(string);
    callback disconnect();
    callback selection-changed(string);
    callback free-only-changed(bool);
    callback toggle-favorite(string);
    callback toggle-country(string);

    spacing: 16px;

    Text {
        text: @tr("Locations");
        font-size: Theme.page-title;
        font-weight: 600;
        color: Theme.text;
    }

    Card {
        vertical-stretch: 1;

        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            // Search across both tabs
            LineEdit {
                placeholder-text: @tr("Search country, city or server");
                text <=> root.search-text;
                edited(text) => {
                    root.search-changed(text);
                }
            }

            Tabs {
                labels: [@tr("Standard"), @tr("Streaming")];
                current <=> root.tab;
            }

            if root.tab == 0: VerticalLayout {
                vertical-stretch: 1;
                spacing: 8px;

                Toggle {
                    text: @tr("Free only");
                    checked: root.free-only;
                    toggled(on) => {
                        root.free-only = on;
                        root.free-only-changed(on);
                    }
                }

                if root.list-message != "": Text {
                    text: root.list-message;
                    wrap: word-wrap;
                    font-size: 12px;
                    color: root.list-state == "error" ? Theme.alert-fg : Theme.text-soft;
                }

                if root.list-state == "loading": Text {
                    text: @tr("Loading server list …");
                    color: Theme.text-soft;
                }

                if root.list-state == "error": HorizontalLayout {
                    alignment: start;
                    SecondaryButton {
                        text: @tr("Try again");
                        clicked => {
                            root.reload-servers();
                        }
                    }
                }

                ServerList {
                    vertical-stretch: 1;
                    rows: root.servers;
                    scroll-y <=> root.servers-scroll;
                    can-connect: root.can-connect;
                    can-switch: root.can-switch;
                    connected-host: root.connected-host;
                    show-empty: root.list-state == "ready";
                    selected-host <=> root.selected-host;
                    selected-name <=> root.selected-name;
                    connect(host) => {
                        root.connect(host);
                    }
                    selection-changed(host) => {
                        root.selection-changed(host);
                    }
                    toggle-favorite(host) => {
                        root.toggle-favorite(host);
                    }
                    toggle-country(code) => {
                        root.toggle-country(code);
                    }
                }
            }

            if root.tab == 1: VerticalLayout {
                vertical-stretch: 1;
                spacing: 8px;

                // Note from a test with the real service: some destinations do not work through streaming servers
                Text {
                    text: @tr("Intended for streaming. Some websites do not work through these servers.");
                    wrap: word-wrap;
                    font-size: 12px;
                    color: Theme.text-soft;
                }

                ServerList {
                    vertical-stretch: 1;
                    rows: root.streaming-servers;
                    scroll-y <=> root.streaming-scroll;
                    can-connect: root.can-connect;
                    can-switch: root.can-switch;
                    connected-host: root.connected-host;
                    show-empty: true;
                    selected-host <=> root.selected-host;
                    selected-name <=> root.selected-name;
                    connect(host) => {
                        root.connect(host);
                    }
                    selection-changed(host) => {
                        root.selection-changed(host);
                    }
                    toggle-favorite(host) => {
                        root.toggle-favorite(host);
                    }
                    toggle-country(code) => {
                        root.toggle-country(code);
                    }
                }
            }
        }
    }

    // Connect: while connected, "Disconnect" and "Connect" are next to each other.
    HorizontalLayout {
        spacing: 10px;

        Text {
            text: root.selected-host == "" ? @tr("No server selected") : @tr("Selected: {}", root.selected-name);
            color: Theme.text-soft;
            vertical-alignment: center;
            // Wrap instead of cutting.
            wrap: word-wrap;
            horizontal-stretch: 1;
        }

        if root.can-disconnect: SecondaryButton {
            text: @tr("Disconnect");
            clicked => {
                root.disconnect();
            }
        }

        PrimaryButton {
            icon-field: false;
            min-width: 150px;
            horizontal-stretch: 0;
            text: root.switching ? @tr("Switching …") : root.connecting ? @tr("Connecting …") : @tr("Connect");
            enabled: root.selected-host != ""
                && (root.can-connect || (root.can-switch && root.selected-host != root.connected-host));
            clicked => {
                root.connect(root.selected-host);
            }
        }
    }
}
