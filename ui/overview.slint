// View "Overview": status card, location, main button, "Connection" and "Favorite locations".
// There is only the one main button; its right, red area blocks the internet or lifts the block.
// The colour of the dot and the text and effect of the main button come finished from `src/look.rs`.

import { Theme } from "theme.slint";
import { ListView } from "std-widgets.slint";
import { BestIcon, Card, CommandBox, Flag, MainButton, SecondaryButton, StatusDot, Star } from "widgets.slint";

// Permanent hint about settings that reduce the protection
export struct HintRow {
    text: string,
    // Red: kill switch off
    alert: bool,
}

// Connection details from `src/look.rs` (`ConnectionDetails`, `ExternalIp`). Duration, amount of data, VPN
// address and DNS servers only in "Connected"; Celata determines the public address itself.
export struct DetailsRow {
    duration: string,
    received: string,
    sent: string,
    address-v4: string,
    address-v6: string,
    dns-v4: string,
    dns-v6: string,
    public-v4: string,
    public-v6: string,
    // Internet blocked: values that need an internet connection show that in red instead of an address.
    // Celata does not bypass the block for this.
    public-blocked: bool,
}

// A row of "Favorite locations" from `src/look.rs` (`FavoriteItem`), the flag from the image cache.
export struct FavoriteItem {
    flag: image,
    // "Germany, Frankfurt #1", only the country for a streaming server (the play symbol says the rest), or the
    // host name
    label: string,
    // Host for connecting; empty: cannot be selected
    host: string,
    // Host the star switches (also when not available)
    star-host: string,
    // "available", "missing" or "loading"
    state: string,
    streaming: bool,
    connected: bool,
    // Text for the selected location ("Streaming, Japan" for a streaming server)
    choice: string,
    // "Best location": the Celata logo instead of the flag; host and star-host are "best"
    best: bool,
}

// A figure: small label, the value below it; "–" without a value
component Figure inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 2px;
    horizontal-stretch: 1;

    Text {
        text: root.label;
        font-size: 12px;
        color: Theme.text-soft;
    }

    Text {
        // "–" is no text to translate.
        text: root.value == "" ? "–" : root.value;
        font-size: 14px;
        font-weight: 600;
        color: Theme.text;
    }
}

// Label of a group in "Connection" and of the lines "IPv4"/"IPv6"
component Label inherits Text {
    font-size: 12px;
    color: Theme.text-soft;
}

// A group of addresses: label above, below one line each for IPv4 and IPv6. The values are never wrapped and
// never cut; "Connection" is wide enough for the longest IPv6 address (`OverviewView`, `ip-measure`).
component AddressGroup inherits VerticalLayout {
    in property <string> label;
    in property <string> v4;
    in property <string> v6;
    // Public address: bold
    in property <bool> strong;
    // Internet blocked: red text instead of the addresses
    in property <bool> alert;
    spacing: 2px;

    Label {
        text: root.label;
    }

    HorizontalLayout {
        spacing: 8px;

        Label {
            text: "IPv4";
            width: 36px;
        }

        Text {
            text: root.v4 == "" ? "–" : root.v4;
            font-size: 13px;
            font-weight: root.strong ? 600 : 400;
            color: root.alert ? Theme.alert-fg : Theme.text;
            horizontal-stretch: 1;
        }
    }

    HorizontalLayout {
        spacing: 8px;

        Label {
            text: "IPv6";
            width: 36px;
        }

        Text {
            text: root.v6 == "" ? "–" : root.v6;
            font-size: 13px;
            font-weight: root.strong ? 600 : 400;
            color: root.alert ? Theme.alert-fg : Theme.text;
            horizontal-stretch: 1;
        }
    }
}

export component OverviewView inherits VerticalLayout {
    in property <string> status-title;
    in property <string> status-text;
    in property <string> server;
    in property <string> detail;
    in property <string> notice;
    in property <string> version-warning;
    in property <string> command;
    in property <bool> warning;
    in property <string> tone;
    in property <bool> switching;
    in property <bool> can-disconnect;
    in-out property <string> selected-host;
    in-out property <string> selected-name;
    in property <bool> can-connect;
    // While connected: switching to a server other than the connected one is possible
    in property <bool> can-switch;
    in property <string> connected-host;
    // Favourites of both tabs, newest first
    in property <[FavoriteItem]> favorites;
    in property <string> main-label;
    in property <string> main-action;
    in property <string> location-label;
    in property <image> location-flag;
    // "Best location": the Celata logo instead of the flag
    in property <bool> location-best;
    in property <[HintRow]> hints;
    in property <DetailsRow> details;
    // Right area of the main button from `src/look.rs`: "route", "unblock" or "none"
    in property <string> main-side;
    in property <string> main-side-label;
    // False only for "route" with the kill switch switched off; `route-hint` then explains why.
    in property <bool> side-available;
    // Colour of the connection state for the main button: "normal", "connected" or "blocked"
    in property <string> state-color: "normal";
    in property <string> route-hint;

    callback unblock-request();
    callback connect(string);
    callback disconnect();
    callback open-locations();
    callback route-request();
    callback toggle-favorite(string);
    callback selection-changed(string);
    // "Celata 0.9.0 is available" from Rust; empty: no hint (the check is off or found nothing newer).
    in property <string> update-text;
    // "Releases": Rust opens the fixed page with `xdg-open`.
    callback open-update();
    // Start of the service, from `StatusView` in `src/state.rs`: button "Start service" (disabled while the
    // password prompt is open), section "Fix permanently" with its command, link to the setup guide.
    in property <bool> start-button-visible;
    in property <bool> start-button-busy;
    in property <bool> fix-rule-visible;
    in property <string> fix-rule-command;
    in property <bool> guide-link-visible;
    callback start-service-clicked();
    callback setup-guide-clicked();

    spacing: 16px;
    alignment: start;

    Text {
        text: @tr("Overview");
        font-size: Theme.page-title;
        font-weight: 600;
        color: Theme.text;
    }

    // --- State; with a red background and border when blocked ---
    Card {
        background: root.warning ? Theme.card-warning : Theme.card;
        border-width: root.warning ? 2px : 1px;
        border-color: root.warning ? Theme.alert-fg : Theme.card-border;

        VerticalLayout {
            padding: 20px;
            spacing: 8px;

            HorizontalLayout {
                spacing: 10px;
                alignment: start;

                VerticalLayout {
                    alignment: center;
                    StatusDot {
                        tone: root.tone;
                    }
                }

                Text {
                    text: root.status-title;
                    font-size: Theme.status-title;
                    font-weight: 600;
                    color: root.warning ? Theme.alert-fg : Theme.text;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    accessible-role: text;
                }
            }

            if root.server != "": Text {
                text: @tr("Server: {}", root.server);
                font-size: 15px;
                color: Theme.text;
                wrap: word-wrap;
            }

            // Text, message, command, button "Start service", "Fix permanently" and the link to the setup guide in one
            // block without spacing of its own: every part brings its distance to the part above, so that hidden parts
            // leave no gap. The new parts are shown and hidden with `visible`/`height`, not with `if`: wrapping texts in
            // an `if` block are measured as one line.
            VerticalLayout {
                spacing: 0px;

                Text {
                    text: root.status-text;
                    wrap: word-wrap;
                    font-size: 14px;
                    color: Theme.text;
                }

                if root.notice != "": VerticalLayout {
                    padding-top: 8px;
                    Text {
                        text: root.notice;
                        wrap: word-wrap;
                        font-size: 14px;
                        font-weight: 600;
                        color: Theme.text;
                    }
                }

                if root.command != "": VerticalLayout {
                    padding-top: 8px;
                    CommandBox {
                        command: root.command;
                    }
                }

                VerticalLayout {
                    visible: root.start-button-visible;
                    height: root.start-button-visible ? self.preferred-height : 0px;
                    padding-top: 12px;

                    HorizontalLayout {
                        alignment: start;
                        SecondaryButton {
                            text: @tr("Start service");
                            enabled: !root.start-button-busy;
                            clicked => {
                                root.start-service-clicked();
                            }
                        }
                    }
                }

                VerticalLayout {
                    visible: root.fix-rule-visible;
                    height: root.fix-rule-visible ? self.preferred-height : 0px;
                    padding-top: 16px;
                    spacing: 6px;

                    Text {
                        text: @tr("Fix permanently");
                        font-size: 14px;
                        font-weight: 600;
                        color: Theme.text;
                        wrap: word-wrap;
                    }

                    Text {
                        text: @tr("Run this command once in a terminal. Afterwards Celata starts the service by itself, without a password. The rule only applies in a session directly at this computer.");
                        font-size: 14px;
                        color: Theme.text;
                        wrap: word-wrap;
                    }

                    CommandBox {
                        command: root.fix-rule-command;
                    }
                }

                VerticalLayout {
                    visible: root.guide-link-visible;
                    height: root.guide-link-visible ? self.preferred-height : 0px;
                    padding-top: 12px;

                    HorizontalLayout {
                        alignment: start;
                        SecondaryButton {
                            text: @tr("Setup guide");
                            clicked => {
                                root.setup-guide-clicked();
                            }
                        }
                    }
                }
            }

            if root.detail != "": Text {
                text: root.detail;
                wrap: word-wrap;
                font-size: 12px;
                color: Theme.text-soft;
            }
        }
    }

    // --- Hints about settings ---
    if root.hints.length > 0: Card {
        VerticalLayout {
            padding: 14px;
            spacing: 6px;

            for hint in root.hints: HorizontalLayout {
                spacing: 8px;

                Text {
                    text: hint.alert ? "!" : "•";
                    width: 12px;
                    font-size: 14px;
                    font-weight: 700;
                    color: hint.alert ? Theme.alert-fg : Theme.text-soft;
                    accessible-role: none;
                }

                Text {
                    text: hint.text;
                    horizontal-stretch: 1;
                    font-size: 13px;
                    font-weight: hint.alert ? 600 : 400;
                    color: hint.alert ? Theme.alert-fg : Theme.text-soft;
                    wrap: word-wrap;
                }
            }
        }
    }

    // --- Hint about a new version ---
    // One short line that does not wrap, therefore in an `if` block.
    if root.update-text != "": Card {
        HorizontalLayout {
            padding: 14px;
            spacing: 8px;

            Text {
                text: "•";
                width: 12px;
                font-size: 14px;
                font-weight: 700;
                color: Theme.accent-fg;
                vertical-alignment: center;
                accessible-role: none;
            }

            Text {
                text: root.update-text;
                horizontal-stretch: 1;
                font-size: 13px;
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: center;
            }

            SecondaryButton {
                text: @tr("Releases");
                clicked => {
                    root.open-update();
                }
            }
        }
    }

    // --- Location: a click opens "Locations" ---
    location := Card {
        min-height: 64px;
        background: location-touch.has-hover ? Theme.button-hover : Theme.card;
        accessible-role: button;
        accessible-label: @tr("Location: {}", root.location-label);
        accessible-action-default => {
            root.open-locations();
        }

        location-focus := FocusScope {
            key-pressed(event) => {
                if (event.text == " " || event.text == Key.Return) {
                    root.open-locations();
                    return accept;
                }
                return reject;
            }

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 12px;

                VerticalLayout {
                    alignment: center;
                    // Flag or logo in the same place; both stay out of the layout's way through `visible`.
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        Flag {
                            y: 3px;
                            source: root.location-flag;
                            visible: !root.location-best;
                        }
                        BestIcon {
                            visible: root.location-best;
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;

                    Text {
                        text: @tr("Location");
                        font-size: Theme.place;
                        color: Theme.text-soft;
                    }

                    Text {
                        text: root.location-label;
                        font-size: Theme.country;
                        font-weight: 600;
                        color: Theme.text;
                        // The full location is shown here, therefore wrap instead of cutting.
                        wrap: word-wrap;
                    }
                }

                Text {
                    text: "›";
                    font-size: 22px;
                    color: Theme.text-soft;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
            }

            location-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.open-locations();
                }
            }
        }

        if location-focus.has-focus: Rectangle {
            border-radius: 8px;
            border-width: 2px;
            border-color: Theme.focus;
        }
    }

    // --- Main button ---
    MainButton {
        text: root.main-label;
        enabled: root.main-action != "none";
        outline: root.main-action == "disconnect";
        side: root.main-side;
        side-text: root.main-side-label;
        side-available: root.side-available;
        state-color: root.state-color;
        clicked => {
            if (root.main-action == "disconnect") {
                root.disconnect();
            } else if (root.main-action == "connect") {
                // An empty selection counts as "Best location"; Rust resolves it.
                root.connect(root.selected-host);
            }
        }
        side-clicked => {
            if (root.main-side == "route") {
                root.route-request();
            } else if (root.main-side == "unblock") {
                root.unblock-request();
            }
        }
    }

    // "Block internet" is greyed out: explain why
    if root.main-side == "route" && !root.side-available: Text {
        text: root.route-hint;
        font-size: 12px;
        color: Theme.text-soft;
        wrap: word-wrap;
    }

    // Disconnect during a switch
    if root.switching && root.can-disconnect: HorizontalLayout {
        alignment: start;
        SecondaryButton {
            text: @tr("Disconnect");
            clicked => {
                root.disconnect();
            }
        }
    }

    // --- Connection and favourite locations ---
    // Next to each other, "Connection" a little wider; one below the other only if the window is too narrow
    // for the longest IPv6 address next to "Favorite locations". The rectangle places both cards itself, so
    // that no conditional block is needed (Slint measures wrapping text in `if` blocks wrongly). "Connection"
    // is always visible and always the same size, whatever the state.
    details-area := Rectangle {
        property <length> gap: 16px;
        property <length> fav-min: 220px;
        // Widest value: the longest IPv6 address, plus the column "IPv4"/"IPv6" and the padding
        property <length> conn-min: max(ip-measure.preferred-width + 36px + 8px, figures-measure.preferred-width)
            + 2 * 16px;
        property <length> conn-w: max(self.conn-min, (self.width - self.gap) * 0.55);
        property <bool> wide: self.width - self.gap - self.conn-w >= self.fav-min;
        property <length> conn-h: conn-layout.preferred-height;
        // One below the other: heading and at most 5 rows
        property <length> fav-h: self.wide ? self.conn-h : fav-title.preferred-height + 5 * 32px + 2 * 16px + 8px;
        height: self.wide ? self.conn-h : self.conn-h + self.gap + self.fav-h;

        // Invisible comparison texts in the font of the values, so that the width does not depend on the
        // current value and nothing jumps when data arrives. "d" and "b" are the widest characters of an IPv6
        // address in Noto Sans Bold (measured 2026-11-19: 8 % wider than digits), so every address fits.
        ip-measure := Text {
            visible: false;
            text: "dddd:dddd:dddd:dddd:dddd:dddd:dddd:dddd";
            font-size: 13px;
            font-weight: 600;
        }

        // Widest figures: a long duration ("23 Std. 59 Min.") and two amounts ("999,9 MB"), as digits of
        // the same width, so that the comparison needs no text to translate.
        figures-measure := HorizontalLayout {
            visible: false;
            spacing: 12px;

            Text {
                text: "00000000000000";
                font-size: 14px;
                font-weight: 600;
            }

            Text {
                text: "00000000";
                font-size: 14px;
                font-weight: 600;
            }

            Text {
                text: "00000000";
                font-size: 14px;
                font-weight: 600;
            }
        }

        Card {
            x: 0;
            y: 0;
            width: parent.wide ? parent.conn-w : parent.width;
            height: parent.conn-h;

            conn-layout := VerticalLayout {
                padding: 16px;
                spacing: 10px;

                Text {
                    text: @tr("Connection");
                    font-size: 15px;
                    font-weight: 600;
                    color: Theme.text;
                }

                HorizontalLayout {
                    spacing: 12px;

                    Figure {
                        label: @tr("Duration");
                        value: root.details.duration;
                    }

                    Figure {
                        label: @tr("Received");
                        value: root.details.received;
                    }

                    Figure {
                        label: @tr("Sent");
                        value: root.details.sent;
                    }
                }

                AddressGroup {
                    label: @tr("VPN address");
                    v4: root.details.address-v4;
                    v6: root.details.address-v6;
                }

                AddressGroup {
                    label: @tr("DNS servers");
                    v4: root.details.dns-v4;
                    v6: root.details.dns-v6;
                }

                // Internet blocked: no query, the red notice instead (Celata does not bypass the block).
                AddressGroup {
                    label: @tr("Public");
                    v4: root.details.public-blocked ? @tr("Internet blocked") : root.details.public-v4;
                    v6: root.details.public-blocked ? @tr("Internet blocked") : root.details.public-v6;
                    strong: true;
                    alert: root.details.public-blocked;
                }
            }
        }

        Card {
            x: parent.wide ? parent.conn-w + parent.gap : 0;
            y: parent.wide ? 0 : parent.conn-h + parent.gap;
            width: parent.wide ? parent.width - parent.conn-w - parent.gap : parent.width;
            height: parent.fav-h;

            VerticalLayout {
                padding: 16px;
                spacing: 8px;

                fav-title := Text {
                    text: @tr("Favorite locations");
                    font-size: 15px;
                    font-weight: 600;
                    color: Theme.text;
                }

                // List and hint share the space; only one of them is visible.
                Rectangle {
                    vertical-stretch: 1;

                    ListView {
                        width: parent.width;
                        height: parent.height;
                        visible: root.favorites.length > 0;

                        for fav in root.favorites: Rectangle {
                            property <bool> selectable: fav.host != "";
                            height: 32px;
                            background: self.selectable && fav.host == root.selected-host
                                ? Theme.row-selected
                                : self.selectable && fav-touch.has-hover ? Theme.row-hover : Theme.card;

                            // The touch area contains the row, so that the star inside it gets its click first.
                            fav-touch := TouchArea {
                                enabled: parent.selectable;
                                clicked => {
                                    root.selected-host = fav.host;
                                    root.selected-name = fav.choice;
                                    root.selection-changed(fav.host);
                                }
                                double-clicked => {
                                    root.selected-host = fav.host;
                                    root.selected-name = fav.choice;
                                    root.selection-changed(fav.host);
                                    if (root.can-connect || (root.can-switch && fav.host != root.connected-host)) {
                                        root.connect(fav.host);
                                    }
                                }

                                // Space on the right for the scroll bar, so that it never covers the star.
                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 14px;
                                    spacing: 8px;

                                    VerticalLayout {
                                        alignment: center;
                                        // Flag or logo in the same place, switched through `visible`.
                                        Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            Flag {
                                                y: 3px;
                                                source: fav.flag;
                                                visible: !fav.best;
                                            }
                                            BestIcon {
                                                visible: fav.best;
                                            }
                                        }
                                    }

                                    Text {
                                        text: fav.label;
                                        font-size: 13px;
                                        color: fav.state == "available" ? Theme.text : Theme.text-soft;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide; // may be cut: the full name is shown in the card "Location"
                                    }

                                    if fav.streaming: VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 0;

                                        // Symbol: lucide-static 1.70.0, icons/play.svg (ISC)
                                        Image {
                                            width: 12px;
                                            height: 12px;
                                            source: @image-url("icons/play.svg");
                                            colorize: Theme.text-soft;
                                            accessible-role: image;
                                            accessible-label: @tr("Streaming server");
                                        }
                                    }

                                    if fav.state != "available": Text {
                                        text: fav.state == "loading" ? @tr("Loading …") : @tr("not available");
                                        font-size: 11px;
                                        color: Theme.text-soft;
                                        vertical-alignment: center;
                                        horizontal-stretch: 0;
                                    }

                                    if fav.connected: VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 0;

                                        Rectangle {
                                            width: 8px;
                                            height: 8px;
                                            border-radius: 4px;
                                            background: Theme.connected-fg;
                                            accessible-role: text;
                                            accessible-label: @tr("Connected");
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 0;
                                        Star {
                                            size: 16px;
                                            on: true;
                                            toggled => {
                                                root.toggle-favorite(fav.star-host);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Text {
                        y: 0;
                        width: parent.width;
                        visible: root.favorites.length == 0;
                        text: @tr("No favorites yet. Mark a location with the star under “Locations”.");
                        wrap: word-wrap;
                        font-size: 13px;
                        color: Theme.text-soft;
                    }
                }
            }
        }
    }

    if root.version-warning != "": Text {
        text: root.version-warning;
        wrap: word-wrap;
        font-size: 12px;
        color: Theme.version-text;
    }
}
